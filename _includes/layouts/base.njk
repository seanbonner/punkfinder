<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v={{ assetVersion }}">
<script>
  window.SITE = {
    indexerUrl: {{ site.indexerUrl | dump | safe }},
    imageBase: {{ site.imageBase | dump | safe }},
    cryptopunksDetailsBase: {{ site.cryptopunksDetailsBase | dump | safe }},
    cryptopunksAccountBase: {{ site.cryptopunksAccountBase | dump | safe }},
    evmNowAddressBase: {{ site.evmNowAddressBase | dump | safe }},
    openseaItemBase: {{ site.openseaItemBase | dump | safe }},
    openseaAccountBase: {{ site.openseaAccountBase | dump | safe }},
    punksMarketBase: {{ site.punksMarketBase | dump | safe }},
    v1cryptopunksBase: {{ site.v1cryptopunksBase | dump | safe }},
    v1WrappedContract: {{ site.v1WrappedContract | dump | safe }},
    v1UnwrappedContract: {{ site.v1UnwrappedContract | dump | safe }},
    v2WrappedContract: {{ site.v2WrappedContract | dump | safe }},
  };
</script>
</head>
<body>
<main class="pf-page">

  <header class="pf-masthead">
    <div>
      <a class="pf-brand" href="/" aria-label="{{ site.title }} home">PUNKFINDER<span class="dot">.</span></a>
      <div class="pf-brand-sub">Field intelligence · Provenance &amp; reachability</div>
    </div>
    <div class="pf-masthead-meta">
      CASE OPENED <span id="pf-opened">—</span><br>
      LIVE CHAIN DATA · PUBLIC SOURCES ONLY
    </div>
  </header>

  {{ content | safe }}

  <footer class="pf-family-footer">
    <span>A <a href="https://punkspunkspunks.com">PunksPunksPunks</a> project</span>
    <div class="pf-family-links">
      <a href="https://punkspunkspunks.com">Hub</a>
      <a href="/about/">How it works</a>
    </div>
  </footer>

</main>
<script>
  (function () {
    var el = document.getElementById("pf-opened");
    if (el) {
      var d = new Date();
      el.textContent = d.toISOString().slice(0, 16).replace("T", " ") + " UTC";
    }
  })();
</script>
</body>
</html>
